(["$[[" "]]"] @punctuation.special (#set! priority 110))
(["|" "." ","] @punctuation.delimiter (#set! priority 110))
(["(" ")" "[" "]"] @punctuation.bracket (#set! priority 110))
((identifier) @variable (#set! priority 110))
((access context: (identifier) @module.builtin)
  (#any-of? @module.builtin "inputs" "matrix" "component")
  (#set! priority 110))
((access property: (identifier) @property) (#set! priority 110))
((function_call name: (identifier) @function.call) (#set! priority 110))
((function_call name: (identifier) @function.builtin)
  (#any-of? @function.builtin "expand_vars" "truncate" "posix_escape" "split")
  (#set! priority 110))
((integer) @number (#set! priority 110))
((string) @string (#set! priority 110))
((escape_sequence) @string.escape (#set! priority 110))

((variable) @variable (#set! priority 110))
(["==" "!=" "=~" "!~" "&&" "||" "!"] @operator (#set! priority 110))
((null) @constant.builtin (#set! priority 110))
((boolean) @boolean (#set! priority 110))
((regex) @string.regexp (#set! priority 110))
((regex_escape) @string.escape (#set! priority 111))

((yaml_string) @string (#set! priority 110))
